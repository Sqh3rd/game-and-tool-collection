  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }

  "Namespace for db column": {
    "scope": "typescript",
    "prefix": "dbcns",
    "body": [
      "export namespace $1 {",
      "\texport const selectSchema = createSelectSchema($2);",
      "\texport type Select = z.infer<typeof selectSchema>;",
      "",
      "\texport const insertSchema = createInsertSchema($2).omit(timestampMask);",
      "\texport type Insert = z.infer<typeof insertSchema>;",
      "",
      "\texport const updateSchema = createUpdateSchema($2).omit(timestampMask);",
      "\texport type Update = z.infer<typeof updateSchema>;",
      "}",
    ],
  },
}
